#  Copy to `.env` and edit only if a port clashes. Every value here works as-is.
#
#  Two things to know about this file:
#
#  1. The hostnames below are the *host-facing* ones — `localhost:9092`,
#     `http://localhost:9000`. They are what pytest, `uv run` and your own psql-
#     style poking around use. docker-compose.yml overrides them per service with
#     the in-network names (`kafka:29092`, `http://minio:9000`), because a
#     container cannot reach another container via localhost. The broker really
#     does listen on two ports for this reason; see the comment on
#     KAFKA_ADVERTISED_LISTENERS in docker-compose.yml.
#
#  2. The MinIO credentials are the documented defaults of a MinIO container
#     bound to loopback. They grant access to one empty local bucket and are not
#     reusable anywhere. `.env` is gitignored regardless.

# ---------------------------------------------------------------------- source
# wikimedia | jetstream. Jetstream is the fallback if Wikimedia is unreachable.
WS_SOURCE_NAME=wikimedia
WS_WIKIMEDIA_STREAM_URL=https://stream.wikimedia.org/v2/stream/recentchange

# ----------------------------------------------------------------------- kafka
# Host port. Containers reach the same broker at kafka:29092 (set in compose).
WS_KAFKA_PORT=9092
WS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
WS_KAFKA_TOPIC=wiki.recentchange
# 3 partitions: enough to show that ordering is per-partition and that the
# domain key distributes, without splitting a laptop-scale topic into slivers.
WS_KAFKA_TOPIC_PARTITIONS=3
# 24 hours. Kafka is the replay buffer; bronze is the long-term audit trail.
WS_KAFKA_RETENTION_MS=86400000
WS_KAFKA_CONSUMER_GROUP=wikistream
# zstd | lz4 | snappy | gzip | none. See docs/throughput.md for the measured
# ratio on this data.
WS_KAFKA_COMPRESSION_TYPE=zstd
# Bounded send buffer, in KB. librdkafka's own default is 1 GB, which turns a
# broker outage into an OOM kill instead of an error.
WS_KAFKA_BUFFER_MAX_KBYTES=65536
# How often the producer logs a throughput line and refreshes its heartbeat.
WS_KAFKA_STATS_INTERVAL_SECONDS=10

# -------------------------------------------------------------------- ingest
# The container HEALTHCHECK reads this file's age. Nothing else does.
WS_PRODUCER_HEARTBEAT_PATH=/tmp/wikistream-producer.heartbeat
# Must exceed one full backoff delay plus one stats interval, or a legitimate
# reconnect would be reported as a dead container.
WS_PRODUCER_HEARTBEAT_TIMEOUT_SECONDS=180

# ---------------------------------------------------------------- object store
WS_MINIO_S3_PORT=9000
WS_MINIO_CONSOLE_PORT=9001
WS_S3_ENDPOINT=http://localhost:9000
WS_S3_ACCESS_KEY=minioadmin
WS_S3_SECRET_KEY=minioadmin
WS_S3_REGION=us-east-1
WS_S3_BUCKET=lakehouse

# --------------------------------------------------------------------- catalog
WS_ICEBERG_REST_PORT=8181
WS_ICEBERG_REST_URI=http://localhost:8181
WS_ICEBERG_CATALOG_NAME=lakehouse
WS_BRONZE_NAMESPACE=bronze
WS_SILVER_NAMESPACE=silver
WS_GOLD_NAMESPACE=gold

# ------------------------------------------------------------------- streaming
# Micro-batch interval. Lower means fresher data and more small files.
WS_TRIGGER_INTERVAL_SECONDS=30
WS_SPARK_UI_PORT=4040
WS_SPARK_DRIVER_MEMORY=2g
# Where streaming checkpoints live. Inside the container this is a named volume,
# so offsets survive `make down`; `make clean` deletes it and the next run starts
# from the beginning of the topic.
WS_CHECKPOINT_ROOT=/opt/spark/checkpoints

# ----------------------------------------------------------------------- trino
WS_TRINO_PORT=8080
WS_TRINO_HOST=localhost
WS_TRINO_USER=wikistream

# ------------------------------------------------------------------- dagster
WS_DAGSTER_PORT=3000

# ------------------------------------------------------------------- logging
# DEBUG | INFO | WARNING | ERROR | CRITICAL
WS_LOG_LEVEL=INFO
# One JSON object per line, so `docker compose logs | jq` works. Set false for
# human-readable text while debugging interactively.
WS_LOG_JSON=true
